# LightweightLLM server URL (self-hosted or hosted instance)
LIGHTWEIGHT_LLM_URL=http://localhost:8000

# Model name to use (must be loaded in your LightweightLLM instance)
LIGHTWEIGHT_LLM_MODEL=mistral-7b-instruct

# Port for the rebyld backend server
PORT=3001

# Frontend URL for CORS (set to your GitHub Pages URL in production)
FRONTEND_URL=https://knownassurajit.github.io
